{
  "manifest_version": 3,
  "name": "輪迴檔案館｜ChatGPT＋Gal AI 雙掃描助手",
  "version": "0.8.39",
  "version_name": "V0.8.39 無時間回覆原生組合格式驗證",
  "description": "輪迴檔案館 V0.8.39：保留 V0.8.38 失敗保全與批次下載；修復第9周目無時間原生回覆的隱藏上下文＋圖片尾標＋平衡引號組合投影，仍維持來源 ID、全文與事件嚴格驗證，失敗資料禁止匯入正史。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://asia-east1-eyvind95-182f0.cloudfunctions.net/*",
    "https://whif.io/*",
    "https://www.whif.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "輪迴歸檔助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://whif.io/chat/*",
        "https://www.whif.io/chat/*"
      ],
      "js": [
        "gal-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
