{
  "manifest_version": 3,
  "name": "輪迴檔案館｜ChatGPT＋Gal AI 雙掃描助手",
  "version": "0.10.1",
  "version_name": "V0.10.01 公路求生未選擇能源與原生模板",
  "description": "輪迴檔案館 V0.10.01：未解鎖載具、末尾圖片標記、原生上下文與程式框證據。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://asia-east1-eyvind95-182f0.cloudfunctions.net/*",
    "https://whif.io/*",
    "https://www.whif.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "輪迴歸檔助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://whif.io/chat/*",
        "https://www.whif.io/chat/*"
      ],
      "js": [
        "gal-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
