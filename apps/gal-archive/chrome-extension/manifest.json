{
  "manifest_version": 3,
  "name": "輪迴檔案館｜ChatGPT＋Gal AI 雙掃描助手",
  "version": "0.7.4",
  "description": "V0.7.4：修正 Gal AI 0.7.3 掃描結果從4則退成0則，恢復原泡泡掃描備援，另保留世界觀／👍辨識；ChatGPT 原掃描不變。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://asia-east1-eyvind95-182f0.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "輪迴歸檔助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
