{
  "manifest_version": 3,
  "name": "輪迴檔案館｜ChatGPT＋Gal AI 雙掃描助手",
  "version": "0.8.37",
  "version_name": "V0.8.37 測試版",
  "description": "輪迴檔案館 V0.8.37：唯讀追蹤玩家原生 ID 的兩筆差額及其文字區間，診斷含來源雜湊與相鄰掃描索引；來源未核實前仍拒絕完整正史匯出，不更動已通過的AI自動繼續與事件驗證。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://asia-east1-eyvind95-182f0.cloudfunctions.net/*",
    "https://whif.io/*",
    "https://www.whif.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "輪迴歸檔助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://whif.io/chat/*",
        "https://www.whif.io/chat/*"
      ],
      "js": [
        "gal-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
