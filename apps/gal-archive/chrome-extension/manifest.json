{
  "manifest_version": 3,
  "name": "輪迴檔案館｜ChatGPT＋Gal AI 雙掃描助手",
  "version": "0.8.35",
  "version_name": "V0.8.35 測試版",
  "description": "輪迴檔案館 V0.8.35：無時間 AI 回覆的隱藏模板、無語言圍欄與尾圖需來源唯一且全文精確比對；保留失敗事件分類，4 小時長掃描，禁止未驗收匯入。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://asia-east1-eyvind95-182f0.cloudfunctions.net/*",
    "https://whif.io/*",
    "https://www.whif.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "輪迴歸檔助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://whif.io/chat/*",
        "https://www.whif.io/chat/*"
      ],
      "js": [
        "gal-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
