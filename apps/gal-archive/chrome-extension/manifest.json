{
  "manifest_version": 3,
  "name": "輪迴檔案館｜ChatGPT＋Gal AI 雙掃描助手",
  "version": "0.7.2",
  "description": "V0.7.2：Gal AI 掃描修正跨畫面重疊比對，找不到重疊會退回縮小步距重試；原 ChatGPT 掃描完整保留。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://asia-east1-eyvind95-182f0.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "輪迴歸檔助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
